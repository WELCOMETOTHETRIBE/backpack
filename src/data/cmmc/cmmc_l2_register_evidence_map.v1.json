{
  "schema": "mactech.cmmc.evidence-map.v1",
  "framework": {
    "name": "NIST SP 800-171 Rev.2",
    "profile": "CMMC Level 2 (110 controls)",
    "control_id_format": "3.x.y"
  },
  "registers": [
    {
      "id": "access_authorization",
      "name": "Access Authorization Register",
      "cadence_hint": "Per request + periodic access reviews (e.g., quarterly)"
    },
    {
      "id": "role_assignment_matrix",
      "name": "Role Assignment Matrix",
      "cadence_hint": "Update on role changes; review quarterly"
    },
    {
      "id": "sod_matrix",
      "name": "Separation of Duties Matrix",
      "cadence_hint": "Update on role/process changes; review annually"
    },
    {
      "id": "authenticator_mgmt",
      "name": "Authenticator Management Register",
      "cadence_hint": "Per issuance/reset/revocation event"
    },
    {
      "id": "training_completion",
      "name": "Training Completion Register",
      "cadence_hint": "Per hire + annually (or per policy)"
    },
    {
      "id": "personnel_screening",
      "name": "Personnel Screening Log",
      "cadence_hint": "Per onboarding event"
    },
    {
      "id": "termination",
      "name": "Termination Log",
      "cadence_hint": "Per offboarding event (same-day recommended)"
    },
    {
      "id": "audit_log_review",
      "name": "Audit Log Review Records",
      "cadence_hint": "Daily/weekly (per policy) + after alerts"
    },
    {
      "id": "audit_config",
      "name": "Audit Configuration Register",
      "cadence_hint": "On onboarding new log sources; review quarterly"
    },
    {
      "id": "control_monitoring",
      "name": "Control Monitoring Log",
      "cadence_hint": "Weekly/monthly attestations + automated checks"
    },
    {
      "id": "incident_log",
      "name": "Incident Log Register",
      "cadence_hint": "Per incident + exercises/tests"
    },
    {
      "id": "maintenance_log",
      "name": "Maintenance Activity Log",
      "cadence_hint": "Per maintenance event"
    },
    {
      "id": "media_access",
      "name": "Media Access Log",
      "cadence_hint": "Per removable media use/exception approval"
    },
    {
      "id": "media_destruction",
      "name": "Media Destruction Log",
      "cadence_hint": "Per sanitization/destruction event"
    },
    {
      "id": "visitor_log",
      "name": "Visitor Log",
      "cadence_hint": "Per visitor entry"
    },
    {
      "id": "facility_access",
      "name": "Facility Access Log",
      "cadence_hint": "Continuous via badge system; reviewed monthly"
    },
    {
      "id": "baseline_config",
      "name": "Baseline Configuration Register",
      "cadence_hint": "Per baseline version + after major changes"
    },
    {
      "id": "change_log",
      "name": "Change Log",
      "cadence_hint": "Per change request/approval/implementation"
    },
    {
      "id": "risk_register",
      "name": "Risk Register",
      "cadence_hint": "Monthly/quarterly updates + after major events"
    },
    {
      "id": "assessment_findings",
      "name": "Security Assessment Findings Register",
      "cadence_hint": "Per assessment + retests"
    },
    {
      "id": "poam",
      "name": "POA&M Tracker",
      "cadence_hint": "Weekly/biweekly updates until closure"
    },
    {
      "id": "vuln_remediation",
      "name": "Vulnerability Remediation Register",
      "cadence_hint": "Continuous + patch/vuln cycle"
    },
    {
      "id": "policy_review",
      "name": "Policy Review Log",
      "cadence_hint": "Annually + after major changes/incidents"
    },
    {
      "id": "technical_compliance_run",
      "name": "Technical Compliance Run",
      "cadence_hint": "Event-driven (per collector run)."
    }
  ],
